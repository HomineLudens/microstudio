{
  "compilerOptions": {
    "target": "ES2017",
    "module": "CommonJS",
    "lib": ["ES2017"],
    "types": ["node"],
    "typeRoots": ["server/node_modules/@types"],
    "rootDir": "ts-src",
    "outDir": ".",
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["ts-src/server/**/*.ts"],
  "exclude": []
}
